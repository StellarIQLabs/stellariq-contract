# Copy to `.env` (NEVER commit `.env`). See docs/ for deployment instructions.
# Only public / non-secret values below. Secret keys are supplied via
# `stellar keys` identities or env vars at deploy time, never in files.

# Target Stellar network: testnet | mainnet (scripts default to testnet and
# refuse mainnet without an explicit confirmation flag)
STELLAR_NETWORK=testnet

# Source identity (a `stellar keys` identity name — NOT a secret key)
STELLAR_SOURCE_ACCOUNT=stellariq-deployer

# Optional: explicit RPC endpoint (defaults to the public endpoint per network)
# STELLAR_RPC_URL=https://soroban-testnet.stellar.org
